<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="#34210F" />
        </shape>
    </item>

    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <gradient
                android:angle="270"
                android:startColor="#EBCB95"
                android:centerColor="#D6AD73"
                android:endColor="#BD8850" />
            <stroke
                android:width="1dp"
                android:color="#8C643A" />
        </shape>
    </item>

    <item android:left="4dp" android:top="6dp" android:right="4dp" android:bottom="38dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <gradient
                android:angle="270"
                android:startColor="#66FFF6DF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <item android:left="6dp" android:top="18dp" android:right="6dp" android:bottom="35dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#1E5D3A1C" />
        </shape>
    </item>

    <item android:left="6dp" android:top="29dp" android:right="6dp" android:bottom="24dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#1858371C" />
        </shape>
    </item>
</layer-list>
