<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
        Exact Original Origami Music Envelope Icon (图二设计):
        - Box / Envelope base: Left (4, 11) -> (4, 18.5) -> Right (18, 18.5)
        - Tall Right Fold: Right edge extends all the way up to (18, 4)
        - Diagonal Roof / Flag: From (18, 4) slopes down-left to (11, 7.5)
        - Center Spine: From (11, 7.5) straight down to (11, 15)
        - Envelope V-Pocket: (4, 11) -> (11, 15) -> (18, 11)
        - Center Music Ring: Centered at (11, 11) on the spine
    -->

    <!-- Outer contour & Origami Flag + Spine -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="
            M 4 11 
            L 4 18.5 
            L 18 18.5 
            L 18 4 
            L 11 7.5 
            L 11 15
        " />

    <!-- Envelope V-Fold -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="
            M 4 11 
            L 11 15 
            L 18 11
        " />

    <!-- Center Hollow Note Ring -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="
            M 9.2 11 
            a 1.8,1.8 0 1,0 3.6,0 
            a 1.8,1.8 0 1,0 -3.6,0
        " />
</vector>
