<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Bottom Shadow (Depth) -->
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/classroom_wood_shadow" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <!-- 2. Desk Top (Surface) -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/classroom_wood_medium"
                android:startColor="@color/classroom_wood_bright"
                android:type="linear" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
