<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSeat"
    android:layout_width="94dp"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@android:color/transparent">

    <TextView
        android:id="@+id/tvColumnIndex"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:alpha="0.35"
        android:text="1"
        android:textColor="#A8CBC0"
        android:textSize="7sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/viewDeskBody"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/bg_seat_card_minimal"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvColumnIndex" />

    <TextView
        android:id="@+id/tvSeatNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginTop="5dp"
        android:elevation="3dp"
        android:text="01"
        android:textColor="#7A4F2F16"
        android:textSize="8sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/viewDeskBody"
        app:layout_constraintTop_toTopOf="@id/viewDeskBody" />

    <TextView
        android:id="@+id/tvSeatName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="6dp"
        android:paddingBottom="7dp"
        android:text="Name"
        android:textColor="#4D2E18"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/viewDeskBody"
        app:layout_constraintEnd_toEndOf="@id/viewDeskBody"
        app:layout_constraintStart_toStartOf="@id/viewDeskBody"
        app:layout_constraintTop_toTopOf="@id/viewDeskBody" />

    <View
        android:id="@+id/viewOccupiedOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.38"
        android:background="@drawable/bg_seat_claimed_overlay_minimal"
        android:elevation="2.2dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/viewDeskBody"
        app:layout_constraintEnd_toEndOf="@id/viewDeskBody"
        app:layout_constraintStart_toStartOf="@id/viewDeskBody"
        app:layout_constraintTop_toTopOf="@id/viewDeskBody" />

    <View
        android:id="@+id/legLeft"
        android:layout_width="4dp"
        android:layout_height="8dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="-1dp"
        android:alpha="0.42"
        android:background="@color/classroom_wood_shadow"
        app:layout_constraintStart_toStartOf="@id/viewDeskBody"
        app:layout_constraintTop_toBottomOf="@id/viewDeskBody" />

    <View
        android:id="@+id/legRight"
        android:layout_width="4dp"
        android:layout_height="8dp"
        android:layout_marginTop="-1dp"
        android:layout_marginEnd="14dp"
        android:alpha="0.42"
        android:background="@color/classroom_wood_shadow"
        app:layout_constraintEnd_toEndOf="@id/viewDeskBody"
        app:layout_constraintTop_toBottomOf="@id/viewDeskBody" />

</androidx.constraintlayout.widget.ConstraintLayout>
