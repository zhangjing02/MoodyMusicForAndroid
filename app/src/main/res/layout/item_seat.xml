<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardSeat"
    android:layout_width="92dp"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@android:color/transparent">

    <!-- Simple Desk Legs (2 bold wooden legs) -->
    <View
        android:id="@+id/legLeft"
        android:layout_width="6dp"
        android:layout_height="12dp"
        android:background="@color/classroom_wood_shadow"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toBottomOf="@id/viewDeskBody"
        app:layout_constraintStart_toStartOf="@id/viewDeskBody"
        android:layout_marginTop="-2dp" />

    <View
        android:id="@+id/legRight"
        android:layout_width="6dp"
        android:layout_height="12dp"
        android:background="@color/classroom_wood_shadow"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/viewDeskBody"
        app:layout_constraintEnd_toEndOf="@id/viewDeskBody"
        android:layout_marginTop="-2dp" />

    <!-- Desk Wood Body (Slightly elevated) -->
    <View
        android:id="@+id/viewDeskBody"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_desk_wood"
        app:layout_constraintTop_toTopOf="parent"
        android:elevation="2dp" />

    <!-- Seat Number (e.g., 01号) -->
    <TextView
        android:id="@+id/tvSeatNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:text="01号"
        android:textColor="#804D3319"
        android:textSize="9sp"
        android:textStyle="bold"
        android:elevation="3dp"
        app:layout_constraintStart_toStartOf="@id/viewDeskBody"
        app:layout_constraintTop_toTopOf="@id/viewDeskBody" />

    <!-- Student Name -->
    <TextView
        android:id="@+id/tvSeatName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="6dp"
        android:text="姓名"
        android:textColor="@color/classroom_wood_shadow"
        android:textSize="13sp"
        android:textStyle="bold"
        android:elevation="3dp"
        app:layout_constraintBottom_toBottomOf="@id/viewDeskBody"
        app:layout_constraintEnd_toEndOf="@id/viewDeskBody"
        app:layout_constraintStart_toStartOf="@id/viewDeskBody"
        app:layout_constraintTop_toTopOf="@id/viewDeskBody" />

    <!-- Occupied/Claimed Visual Overlay -->
    <View
        android:id="@+id/viewOccupiedOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.4"
        android:background="#1B3F2E"
        android:visibility="gone"
        android:elevation="2.5dp"
        app:layout_constraintBottom_toBottomOf="@id/viewDeskBody"
        app:layout_constraintEnd_toEndOf="@id/viewDeskBody"
        app:layout_constraintStart_toStartOf="@id/viewDeskBody"
        app:layout_constraintTop_toTopOf="@id/viewDeskBody" />

    <ImageView
        android:id="@+id/ivClaimed"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_margin="6dp"
        android:src="@drawable/ic_locked"
        android:tint="@color/white"
        android:visibility="gone"
        android:elevation="3dp"
        app:layout_constraintEnd_toEndOf="@id/viewDeskBody"
        app:layout_constraintTop_toTopOf="@id/viewDeskBody" />

</androidx.constraintlayout.widget.ConstraintLayout>
